// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. ตาราง User (สำหรับ Login)
model User {
  id       Int      @id @default(autoincrement())
  username String   @unique // ห้ามซ้ำ
  password String
  role     String   @default("student") // admin หรือ student
  student  Student? // เชื่อมโยงไปหาข้อมูลนักเรียน
}

// 2. ตาราง Student (ข้อมูลส่วนตัวนักเรียน)
model Student {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  gpax      Float   // เกรดเฉลี่ย
  
  // การเชื่อมโยง (Relation) กลับไปหา User
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id])
}